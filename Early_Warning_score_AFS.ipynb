<div class=" highlight hl-ipython3"><pre><span></span><span class="kn">from</span> <span class="nn">IPython.display</span> <span class="kn">import</span> <span class="n">display</span><span class="p">,</span> <span class="n">HTML</span>

<span class="c1"># Calculate basic stats</span>
<span class="n">total_customers</span> <span class="o">=</span> <span class="n">customers_df</span><span class="p">[</span><span class="s1">'customer_id'</span><span class="p">]</span><span class="o">.</span><span class="n">nunique</span><span class="p">()</span>
<span class="n">total_txns</span> <span class="o">=</span> <span class="nb">len</span><span class="p">(</span><span class="n">transactions_df</span><span class="p">)</span>
<span class="n">total_volume</span> <span class="o">=</span> <span class="n">transactions_df</span><span class="p">[</span><span class="s1">'amount'</span><span class="p">]</span><span class="o">.</span><span class="n">sum</span><span class="p">()</span>
<span class="n">default_rate</span> <span class="o">=</span> <span class="n">customers_df</span><span class="p">[</span><span class="s1">'is_default_bound'</span><span class="p">]</span><span class="o">.</span><span class="n">mean</span><span class="p">()</span> <span class="o">*</span> <span class="mi">100</span>

<span class="c1"># HTML for KPI Tiles</span>
<span class="n">html_str</span> <span class="o">=</span> <span class="sa">f</span><span class="s2">"""</span>
<span class="s2">&lt;div style="display: flex; justify-content: space-between; margin-bottom: 20px;"&gt;</span>
<span class="s2">    &lt;div style="background-color: #f4f6f9; padding: 20px; border-radius: 10px; width: 22%; text-align: center; box-shadow: 2px 2px 5px rgba(0,0,0,0.1);"&gt;</span>
<span class="s2">        &lt;h3 style="margin: 0; color: #333;"&gt;Total Customers&lt;/h3&gt;</span>
<span class="s2">        &lt;h1 style="margin: 5px 0; color: #0056b3;"&gt;</span><span class="si">{</span><span class="n">total_customers</span><span class="si">:</span><span class="s2">,</span><span class="si">}</span><span class="s2">&lt;/h1&gt;</span>
<span class="s2">    &lt;/div&gt;</span>
<span class="s2">    &lt;div style="background-color: #f4f6f9; padding: 20px; border-radius: 10px; width: 22%; text-align: center; box-shadow: 2px 2px 5px rgba(0,0,0,0.1);"&gt;</span>
<span class="s2">        &lt;h3 style="margin: 0; color: #333;"&gt;Total Transactions&lt;/h3&gt;</span>
<span class="s2">        &lt;h1 style="margin: 5px 0; color: #0056b3;"&gt;</span><span class="si">{</span><span class="n">total_txns</span><span class="si">:</span><span class="s2">,</span><span class="si">}</span><span class="s2">&lt;/h1&gt;</span>
<span class="s2">    &lt;/div&gt;</span>
<span class="s2">    &lt;div style="background-color: #f4f6f9; padding: 20px; border-radius: 10px; width: 22%; text-align: center; box-shadow: 2px 2px 5px rgba(0,0,0,0.1);"&gt;</span>
<span class="s2">        &lt;h3 style="margin: 0; color: #333;"&gt;Total Volume ($)&lt;/h3&gt;</span>
<span class="s2">        &lt;h1 style="margin: 5px 0; color: #0056b3;"&gt;$</span><span class="si">{</span><span class="n">total_volume</span><span class="si">:</span><span class="s2">,.0f</span><span class="si">}</span><span class="s2">&lt;/h1&gt;</span>
<span class="s2">    &lt;/div&gt;</span>
<span class="s2">    &lt;div style="background-color: #f4f6f9; padding: 20px; border-radius: 10px; width: 22%; text-align: center; box-shadow: 2px 2px 5px rgba(0,0,0,0.1);"&gt;</span>
<span class="s2">        &lt;h3 style="margin: 0; color: #333;"&gt;Default-Bound %&lt;/h3&gt;</span>
<span class="s2">        &lt;h1 style="margin: 5px 0; color: #d9534f;"&gt;</span><span class="si">{</span><span class="n">default_rate</span><span class="si">:</span><span class="s2">.1f</span><span class="si">}</span><span class="s2">%&lt;/h1&gt;</span>
<span class="s2">    &lt;/div&gt;</span>
<span class="s2">&lt;/div&gt;</span>
<span class="s2">"""</span>
<span class="n">display</span><span class="p">(</span><span class="n">HTML</span><span class="p">(</span><span class="n">html_str</span><span class="p">))</span>
